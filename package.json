{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{ts,tsx,css}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,tsx,css}\"",
        "lint": "eslint \"resources/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"resources/**/*.{ts,tsx}\" --fix",
        "check": "npm run format && npm run lint:fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@chakra-ui/react": "^3.35.0",
        "@emotion/react": "^11.14.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^7.16.0"
    }
}
